// use prisma-next

model Entrepreneur {
  id           Int      @id @default(autoincrement())
  fullName     String
  email        String   @unique
  password     String
  phone        String?
  businessName String?
  status       String   @default("PENDING")
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}

// Stores products added by entrepreneurs
model Product {
  id             Int      @id @default(autoincrement())
  entrepreneurId Int
  name           String
  category       String
  description    String?
  price          Float
  quantity       Int
  status         String   @default("PENDING")
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
}