// Startup Spark — shared database schema
// This is the ONE schema.prisma for the whole team. Do not fork it per-branch.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 
// ENUMS
// 

enum UserRole {
  ENTREPRENEUR
  ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  AWAITING_FULFILLMENT
  PENDING_VERIFICATION
  VERIFIED
  FLAGGED
  CANCELLED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FLAGGED
}

// 
// USERS & AUTH (Entrepreneurs + Admins only — customers are guests)
// 

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole
  name         String
  phone        String?
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entrepreneurProfile EntrepreneurProfile?
  notifications       Notification[]

  reviewedEntrepreneurs EntrepreneurProfile[] @relation("EntrepreneurReviewedBy")
  reviewedProducts      Product[]             @relation("ProductReviewedBy")
  verifiedSales         SalesConfirmation[]   @relation("SalesVerifiedBy")
  galleryItems          GalleryItem[]         @relation("GalleryUploadedBy")
  contentEdits          ContentBlock[]        @relation("ContentUpdatedBy")

  @@index([role])
}

model EntrepreneurProfile {
  id              String         @id @default(cuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id])

  university      String?
  studentId       String?
  bio             String?
  whatsappNumber  String

  status          ApprovalStatus @default(PENDING)
  rejectionReason String?
  appliedAt       DateTime       @default(now())
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?          @relation("EntrepreneurReviewedBy", fields: [reviewedById], references: [id])

  business        Business?

  @@index([status])
}

model Business {
  id                    String              @id @default(cuid())
  entrepreneurProfileId String              @unique
  entrepreneurProfile   EntrepreneurProfile @relation(fields: [entrepreneurProfileId], references: [id])

  businessName          String
  description           String?
  logoUrl               String?
  businessCategory      String?
  instagramHandle       String?
  websiteUrl            String?
  businessHours         String?
  pickupLocationNotes   String?

  products              Product[]
  orders                Order[]

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

// 
// CATEGORIES & PRODUCTS
// 

